{
  "name": "yorozu-app-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yorozu-app",
      // Replace with the real database_id from `wrangler d1 create yorozu-app`.
      // A placeholder UUID is acceptable for local-only development.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      // Replace with the real bucket name from `wrangler r2 bucket create`.
      "bucket_name": "yorozu-app-images"
    }
  ],
  "vars": {
    // Replace with production origins (e.g. "https://admin.example.com").
    // For local dev, set these to the Vite dev server URLs in .dev.vars.
    "ADMIN_ORIGIN": "http://localhost:5173",
    "ORDER_ORIGIN": "http://localhost:5174",
    "SIGNUP_ORIGIN": "http://localhost:5175",
    "SHIFT_ORIGIN": "http://localhost:5176",
    // Set to ".example.com" in production for cross-subdomain cookie sharing.
    // Leave empty in local dev so the cookie is scoped to localhost only.
    "COOKIE_DOMAIN": "",
    // Set to "development" in .dev.vars for local dev to expose the Magic
    // Link URL in API responses, bypassing the need for email delivery.
    "ENVIRONMENT": "production"
    // RESEND_API_KEY, MAIL_FROM and OTP_PEPPER are secrets — set via
    // `wrangler secret put` or in .dev.vars for local development.
  }
}
