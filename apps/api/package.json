{
  "name": "@yorozu/api",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "db:migrate": "wrangler d1 migrations apply yorozu-app --local",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && pnpm db:migrate"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "@yorozu/core": "workspace:*",
    "@yorozu/db": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "^4.12.26",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.18",
    "@cloudflare/workers-types": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
